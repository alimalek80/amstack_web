# Copy this file to .env.local for local development.

# Where the Next.js server reaches the Django backend (server-side fetches and the dev proxy).
# In Docker this becomes http://backend:8000
API_ORIGIN=http://127.0.0.1:8000

# Public URL of the site, used for metadata and the sitemap.
SITE_URL=http://localhost:3000

# How long (in seconds) fetched API data is cached. Use 0 in development to always see fresh data.
API_REVALIDATE_SECONDS=600
